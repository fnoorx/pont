# Supabase project (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: webhook and seed scripts only. Never share with the dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to salt phone number hashes. Do not change once data exists.
PHONE_HASH_SALT=

# Demo staff login created by `npm run seed`
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Twilio (Console > Account info). Used by the webhook Edge Function.
# Set them as function secrets too: see README "WhatsApp setup".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp sandbox (not secret). Used by `npm run demo:card` for the judge QR code.
# Find both in Twilio > Messaging > Try it out > Send a WhatsApp message.
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_SANDBOX_JOIN_CODE=
