# Supabase project (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: Edge Function and scripts only. Never share with the dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to salt phone number hashes. Do not change once data exists.
PHONE_HASH_SALT=

# Demo staff login created by `npm run seed`
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
