# PS43 Foundation staff dashboard — database connection
#
# Copy this file to ".env" (never commit .env) and fill in your project's
# values from Supabase → Project Settings → API. The dashboard also runs
# without this file using the connection values baked into src/lib/ps43.ts.

# Project URL, e.g. https://pfniphvzvgmmghejwadl.supabase.co
VITE_SUPABASE_URL=

# Anon (public) key from API settings — safe for the browser, not a secret
VITE_SUPABASE_ANON_KEY=
